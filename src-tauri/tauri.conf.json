{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Satellite Tracker",
  "version": "1.0.0",
  "identifier": "com.furkan.satellitetracker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SATELLITE TRACKER",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Furkan",
    "copyright": "© 2026 Furkan",
    "category": "Education",
    "shortDescription": "3D uydu takip uygulaması",
    "longDescription": "CelesTrak yörünge verileriyle 3D Dünya üzerinde uydu takibi.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish"],
        "displayLanguageSelector": false
      }
    }
  }
}
